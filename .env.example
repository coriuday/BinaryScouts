# Admin (required for /admin login)
ADMIN_PASSWORD=change-me-to-a-long-random-string
ADMIN_SESSION_SECRET=another-long-random-string

# Optional: email delivery for contact/newsletter (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@binaryscouts.com
CONTACT_FROM_EMAIL=BinaryScouts <onboarding@resend.dev>

# Optional: override backend URLs (defaults to localhost)
RUST_API_URL=http://127.0.0.1:8081/api/chat
RUST_API_URL_HEIST=http://127.0.0.1:8081/api/heist
INTERNAL_API_KEY=

