# Public site URL (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://binary-scouts.vercel.app

# Admin (required for /admin login)
ADMIN_PASSWORD=change-me-to-a-long-random-string
ADMIN_SESSION_SECRET=another-long-random-string

# Supabase CMS (required for admin CRUD + live content)
# Get keys from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Render deployment (Web Service env vars) ---
# Set the same Supabase + admin vars above on Render. Example:
# NEXT_PUBLIC_SITE_URL=https://your-app.onrender.com
# ADMIN_PASSWORD=...
# ADMIN_SESSION_SECRET=...
# Do NOT set DATABASE_URL on Render unless running migration scripts.

# Local-only: Postgres pooler for npm run migrate:pg (not needed on Render)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Contact + WhatsApp (public display + inbox notifications)
NEXT_PUBLIC_CONTACT_EMAIL=thebinaryscouts@gmail.com
NEXT_PUBLIC_WHATSAPP_NUMBER=916301464708
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi BinaryScouts! I'd like to discuss a project with you.
CONTACT_TO_EMAIL=thebinaryscouts@gmail.com

# Gmail API (HTTPS — works on Render free tier; SMTP ports are blocked)
# 1. Enable Gmail API in Google Cloud Console
# 2. Create OAuth Desktop credentials
# 3. Run: npm run gmail:setup
GMAIL_USER=thebinaryscouts@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional: override backend URLs (defaults to localhost)
# Render blueprint sets RUST_API_BASE_URL from the Rust service URL automatically.
# Local dev: set RUST_API_BASE_URL=http://127.0.0.1:8081 and run backend-rust for planner/chat.
RUST_API_BASE_URL=
RUST_API_URL=http://127.0.0.1:8081/api/chat
RUST_API_URL_HEIST=http://127.0.0.1:8081/api/heist
# Render API (local only — for npm run render:setup; revoke and regenerate if exposed)
# RENDER_API_KEY=rnd_...

# Shared secret between Next.js and Rust gateway (set same value on Render for binaryscouts + binaryscouts-rust)
INTERNAL_API_KEY=

# After keys appeared in chat, rotate in Supabase Dashboard → Settings → API, then update here + Render env.
# GEMINI_API_KEY=
