# ── BinaryScouts Rust Gateway — copy to .env ──

# Listen address
HOST=127.0.0.1
PORT=8081

# Python FastAPI microservice (must be running on this URL)
PYTHON_AI_BASE_URL=http://127.0.0.1:5000
PYTHON_CHAT_PATH=/ai/chat
PYTHON_HEIST_PATH=/ai/analyze-brief

# Heist dossier storage (relative to backend-rust/)
VAULT_DIR=vault

# Shared secret with Next.js — set the SAME value in root .env.local
INTERNAL_API_KEY=

# Optional logging
RUST_LOG=info
